{
  "name": "restaurant-promotion-platform",
  "version": "0.0.0",
  "private": true,
  "packageManager": "npm@10.9.3",
  "scripts": {
    "dev": "next dev",
    "build": "next build",
    "build:deploy": "prisma generate && next build",
    "start": "next start",
    "lint": "eslint .",
    "typecheck": "tsc --noEmit",
    "test": "vitest run",
    "e2e": "playwright test",
    "smoke:demo": "playwright test public-demo.spec.ts",
    "test:watch": "vitest",
    "format": "prettier --check .",
    "format:write": "prettier --write .",
    "prisma:generate": "prisma generate",
    "prisma:migrate:dev": "prisma migrate dev",
    "prisma:migrate:deploy": "prisma migrate deploy",
    "prisma:validate": "prisma validate",
    "seed:demo": "node --experimental-strip-types scripts/seed-demo.ts",
    "provision:demo-pool": "node --experimental-strip-types scripts/provision-demo-pool.ts",
    "prune:public-claim-rate-limits": "node --experimental-strip-types scripts/prune-public-claim-rate-limits.ts"
  },
  "dependencies": {
    "@node-rs/argon2": "2.2.1",
    "@prisma/client": "6.12.0",
    "next": "16.4.5",
    "next-auth": "5.0.0-beta.32",
    "react": "19.3.0",
    "react-dom": "19.3.0",
    "zod": "4.6.7"
  },
  "devDependencies": {
    "@eslint/eslintrc": "3.3.7",
    "@eslint/js": "9.39.5",
    "@playwright/test": "1.65.0",
    "@tailwindcss/postcss": "4.3.3",
    "@testing-library/react": "16.3.3",
    "@types/node": "22.20.3",
    "@types/react": "19.3.0",
    "@types/react-dom": "19.3.0",
    "eslint": "9.39.5",
    "globals": "16.5.0",
    "postcss": "8.5.28",
    "prettier": "3.9.6",
    "prisma": "6.12.0",
    "tailwindcss": "4.3.3",
    "typescript": "5.9.3",
    "typescript-eslint": "8.70.0",
    "vitest": "5.1.0"
  },
  "engines": {
    "node": "22.x",
    "npm": ">=10.0.0"
  }
}
