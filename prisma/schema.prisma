generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

enum RestaurantOrganizationStatus {
  ACTIVE
  DISABLED
  ARCHIVED
}

enum BranchStatus {
  ACTIVE
  DISABLED
  ARCHIVED
}

enum UserStatus {
  ACTIVE
  DISABLED
  ARCHIVED
}

enum MembershipRole {
  OWNER
  MANAGER
  STAFF
}

enum MembershipStatus {
  ACTIVE
  DISABLED
}

enum AcquisitionChannelStatus {
  ACTIVE
  ARCHIVED
}

enum PromotionStatus {
  DRAFT
  SCHEDULED
  ACTIVE
  PAUSED
  ENDED
  ARCHIVED
}

enum PromotionRewardType {
  FIXED_AMOUNT
  PERCENTAGE
  SPEND_THRESHOLD
}

enum PromotionCodeType {
  SHARED
  UNIQUE
}

enum PromotionCodeStatus {
  ACTIVE
  ARCHIVED
}

model RestaurantOrganization {
  id                      String                       @id @default(cuid())
  name                    String
  slug                    String                       @unique
  timezone                String                       @default("America/Toronto")
  currency                String                       @default("CAD") @db.Char(3)
  status                  RestaurantOrganizationStatus @default(ACTIVE)
  acquisitionChannels     AcquisitionChannel[]
  branches                Branch[]
  customers               Customer[]
  organizationMemberships OrganizationMembership[]
  promotions              Promotion[]
  promotionBranches       PromotionBranch[]
  promotionCodes          PromotionCode[]
  auditLogs               AuditLog[]
  createdAt               DateTime                     @default(now())
  updatedAt               DateTime                     @updatedAt

  @@index([status])
}

model AcquisitionChannel {
  id              String                   @id @default(cuid())
  organizationId  String
  organization    RestaurantOrganization   @relation(fields: [organizationId], references: [id], onDelete: Restrict, onUpdate: Cascade)
  name            String
  isSystemDefault Boolean                  @default(false)
  status          AcquisitionChannelStatus @default(ACTIVE)
  sortOrder       Int                      @default(0)
  customers       Customer[]
  createdAt       DateTime                 @default(now())
  updatedAt       DateTime                 @updatedAt

  @@unique([id, organizationId])
  @@unique([organizationId, name])
  @@index([organizationId, status, sortOrder])
}

model Customer {
  id                    String                  @id @default(cuid())
  organizationId        String
  organization          RestaurantOrganization @relation(fields: [organizationId], references: [id], onDelete: Restrict, onUpdate: Cascade)
  acquisitionChannelId  String?
  acquisitionChannel    AcquisitionChannel?     @relation(fields: [acquisitionChannelId, organizationId], references: [id, organizationId], onDelete: Restrict, onUpdate: Cascade)
  phoneNumberRaw        String
  phoneNumberNormalized String
  phoneNumberDisplay    String
  firstSeenAt           DateTime                @default(now())
  lastSeenAt            DateTime                @default(now())
  createdAt             DateTime                @default(now())
  updatedAt             DateTime                @updatedAt

  @@unique([id, organizationId])
  @@unique([organizationId, phoneNumberNormalized])
  @@index([organizationId, acquisitionChannelId])
  @@index([organizationId, lastSeenAt])
}

model Branch {
  id                String                 @id @default(cuid())
  organizationId    String
  organization      RestaurantOrganization @relation(fields: [organizationId], references: [id], onDelete: Restrict, onUpdate: Cascade)
  name              String
  timezone          String                 @default("America/Toronto")
  status            BranchStatus           @default(ACTIVE)
  branchMemberships BranchMembership[]
  promotionBranches PromotionBranch[]
  auditLogs          AuditLog[]
  createdAt         DateTime               @default(now())
  updatedAt         DateTime               @updatedAt

  @@unique([organizationId, name])
  @@unique([id, organizationId])
  @@index([organizationId, status])
}

model User {
  id                      String                   @id @default(cuid())
  email                   String                   @unique
  name                    String
  passwordHash            String
  status                  UserStatus               @default(ACTIVE)
  organizationMemberships OrganizationMembership[]
  createdAt               DateTime                 @default(now())
  updatedAt               DateTime                 @updatedAt

  @@index([status])
}

model OrganizationMembership {
  id                String                 @id @default(cuid())
  organizationId    String
  organization      RestaurantOrganization @relation(fields: [organizationId], references: [id], onDelete: Restrict, onUpdate: Cascade)
  userId            String
  user              User                   @relation(fields: [userId], references: [id], onDelete: Restrict, onUpdate: Cascade)
  role              MembershipRole
  status            MembershipStatus       @default(ACTIVE)
  branchMemberships BranchMembership[]
  createdPromotions Promotion[]
  auditLogs         AuditLog[]              @relation("AuditActor")
  createdAt         DateTime               @default(now())
  updatedAt         DateTime               @updatedAt

  @@unique([organizationId, userId])
  @@index([organizationId, status, role])
  @@index([userId, status])
}

model BranchMembership {
  id                     String                 @id @default(cuid())
  organizationId         String
  branchId               String
  branch                 Branch                 @relation(fields: [branchId, organizationId], references: [id, organizationId], onDelete: Restrict, onUpdate: Cascade)
  userId                 String
  organizationMembership OrganizationMembership @relation(fields: [organizationId, userId], references: [organizationId, userId], onDelete: Restrict, onUpdate: Cascade)
  role                   MembershipRole
  status                 MembershipStatus       @default(ACTIVE)
  createdAt              DateTime               @default(now())
  updatedAt              DateTime               @updatedAt

  @@unique([branchId, userId])
  @@index([organizationId, userId, status])
  @@index([organizationId, branchId, status, role])
}

model Promotion {
  id                   String                 @id @default(cuid())
  organizationId       String
  organization         RestaurantOrganization @relation(fields: [organizationId], references: [id], onDelete: Restrict, onUpdate: Cascade)
  name                 String
  description          String?
  status               PromotionStatus        @default(DRAFT)
  rewardType           PromotionRewardType
  discountCents        Int?
  discountPercent      Int?
  maxDiscountCents     Int?
  minimumSpendCents    Int?
  validFrom            DateTime?
  validUntil           DateTime?
  appliesToAllBranches Boolean                @default(true)
  createdByUserId      String
  createdByMembership  OrganizationMembership @relation(fields: [organizationId, createdByUserId], references: [organizationId, userId], onDelete: Restrict, onUpdate: Cascade)
  branches             PromotionBranch[]
  codes                PromotionCode[]
  auditLogs            AuditLog[]
  createdAt            DateTime               @default(now())
  updatedAt            DateTime               @updatedAt

  @@unique([id, organizationId])
  @@index([organizationId, status, validFrom, validUntil])
  @@index([organizationId, rewardType])
  @@index([organizationId, createdByUserId])
}

model PromotionBranch {
  id             String                 @id @default(cuid())
  organizationId String
  organization   RestaurantOrganization @relation(fields: [organizationId], references: [id], onDelete: Restrict, onUpdate: Cascade)
  promotionId    String
  promotion      Promotion             @relation(fields: [promotionId, organizationId], references: [id, organizationId], onDelete: Restrict, onUpdate: Cascade)
  branchId       String
  branch         Branch                @relation(fields: [branchId, organizationId], references: [id, organizationId], onDelete: Restrict, onUpdate: Cascade)
  createdAt      DateTime              @default(now())

  @@unique([id, organizationId])
  @@unique([promotionId, branchId])
  @@index([organizationId, branchId])
}

model PromotionCode {
  id             String                 @id @default(cuid())
  organizationId String
  organization   RestaurantOrganization @relation(fields: [organizationId], references: [id], onDelete: Restrict, onUpdate: Cascade)
  promotionId    String
  promotion      Promotion             @relation(fields: [promotionId, organizationId], references: [id, organizationId], onDelete: Restrict, onUpdate: Cascade)
  code           String
  codeType       PromotionCodeType
  status         PromotionCodeStatus   @default(ACTIVE)
  createdAt      DateTime              @default(now())
  updatedAt      DateTime              @updatedAt

  @@unique([id, organizationId])
  @@unique([organizationId, code])
  @@index([organizationId, promotionId, status])
}

model AuditLog {
  id              String                 @id @default(cuid())
  organizationId  String
  organization    RestaurantOrganization @relation(fields: [organizationId], references: [id], onDelete: Restrict, onUpdate: Cascade)
  branchId        String?
  branch          Branch?                @relation(fields: [branchId, organizationId], references: [id, organizationId], onDelete: Restrict, onUpdate: Cascade)
  actorUserId     String
  actorMembership OrganizationMembership @relation("AuditActor", fields: [organizationId, actorUserId], references: [organizationId, userId], onDelete: Restrict, onUpdate: Cascade)
  actorRole       MembershipRole
  action          String
  entityType      String
  entityId        String
  promotionId     String?
  promotion       Promotion?             @relation(fields: [promotionId, organizationId], references: [id, organizationId], onDelete: Restrict, onUpdate: Cascade)
  reason          String?
  beforeJson      Json?
  afterJson       Json?
  metadataJson    Json?
  createdAt       DateTime               @default(now())

  @@index([organizationId, createdAt])
  @@index([organizationId, entityType, entityId])
  @@index([actorUserId, createdAt])
  @@index([organizationId, promotionId, createdAt])
}
